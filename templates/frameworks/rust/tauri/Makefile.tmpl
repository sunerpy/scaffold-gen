# <<project_name>> Makefile
# Simplify common development tasks

.PHONY: help dev build clean install-deps fmt lint test<% if enable_proto_gen %> proto-gen proto-rust proto-ts<% endif %><% if enable_error_gen %> error-gen error-rust error-ts<% endif %>

# Default target
help:
	@echo "Available targets:"
<% if enable_proto_gen %>
	@echo "  proto-gen     - Generate all protobuf code (Rust and TypeScript)"
	@echo "  proto-rust    - Generate only Rust protobuf code"
	@echo "  proto-ts      - Generate only TypeScript protobuf code"
<% endif %>
<% if enable_error_gen %>
	@echo "  error-gen     - Generate error types (Rust + TypeScript)"
	@echo "  error-rust    - Generate Rust error types only"
	@echo "  error-ts      - Generate TypeScript error types only"
<% endif %>
	@echo "  dev           - Start development server"
	@echo "  build         - Build project for production"
	@echo "  clean         - Clean generated files and build artifacts"
	@echo "  install-deps  - Install all dependencies"
	@echo "  fmt           - Format code"
	@echo "  lint          - Run linters"
	@echo "  test          - Run tests"

<% if enable_proto_gen %>
# Generate all protobuf code
proto-gen:
	@echo "🔄 Generating protobuf code..."
	cargo run -p proto-gen -- all
	@echo "✅ Protobuf code generation completed!"

# Generate only Rust protobuf code
proto-rust:
	@echo "🦀 Generating Rust protobuf code..."
	cargo run -p proto-gen -- rust
	@echo "✅ Rust protobuf code generation completed!"

# Generate only TypeScript protobuf code
proto-ts:
	@echo "📘 Generating TypeScript protobuf code..."
	cargo run -p proto-gen -- typescript
	@echo "✅ TypeScript protobuf code generation completed!"
<% endif %>

<% if enable_error_gen %>
# Generate error types (Rust + TypeScript)
error-gen:
	@echo "🔄 Generating error types..."
	cargo run -p error-gen
	@echo "✅ Error type generation completed!"

# Generate Rust error types only
error-rust:
	@echo "🦀 Generating Rust error types..."
	cargo run -p error-gen -- rust
	@echo "✅ Rust error types generated!"

# Generate TypeScript error types only
error-ts:
	@echo "📘 Generating TypeScript error types..."
	cargo run -p error-gen -- ts
	@echo "✅ TypeScript error types generated!"
<% endif %>

# Start development server
dev:<% if enable_proto_gen %> proto-gen<% endif %>
	@echo "🚀 Starting development server..."
	cargo tauri dev

# Build project for production
build:<% if enable_proto_gen %> proto-gen<% endif %>
	@echo "📦 Building project..."
	cargo tauri build

# Clean generated files and build artifacts
clean:
	@echo "🧹 Cleaning generated files..."
<% if enable_proto_gen %>
	@rm -f src-tauri/src/protos/*.rs 2>/dev/null || true
	@rm -f src/protos/*.ts 2>/dev/null || true
	@cd tools/proto-gen && cargo clean
<% endif %>
<% if enable_error_gen %>
	@cd tools/error-gen && cargo clean
<% endif %>
	@cd src-tauri && cargo clean
	@rm -rf node_modules 2>/dev/null || true
	@rm -rf dist 2>/dev/null || true
	@echo "✅ Cleanup completed!"

# Install all dependencies
install-deps:
	@echo "📦 Installing dependencies..."
	@echo "Installing Node.js dependencies..."
	pnpm install
<% if enable_proto_gen %>
	@echo "Building proto-gen tool..."
	@cd tools/proto-gen && cargo build --release
<% endif %>
<% if enable_error_gen %>
	@echo "Building error-gen tool..."
	@cd tools/error-gen && cargo build --release
<% endif %>
	@echo "✅ Dependencies installation completed!"

# Format code
fmt:
	@echo "🎨 Formatting code..."
	cargo fmt --all
	pnpm run format 2>/dev/null || true
	@echo "✅ Formatting completed!"

# Run linters
lint:
	@echo "🔍 Running linters..."
	cargo clippy --all-targets --all-features -- -D warnings
	pnpm run lint 2>/dev/null || true
	@echo "✅ Linting completed!"

# Run tests
test:
	@echo "🧪 Running tests..."
	cargo test --all
	pnpm run test 2>/dev/null || true
	@echo "✅ Tests completed!"
