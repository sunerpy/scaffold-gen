<template>
  <n-tooltip v-if="simple" placement="right" trigger="hover">
    <template #trigger>
      <div class="theme-toggle-btn simple" @click="cycleTheme">
        <n-icon size="20" class="theme-icon">
          <component :is="themeIconComponent" />
        </n-icon>
      </div>
    </template>
        {{ currentThemeLabel }}
  </n-tooltip>

  <n-dropdown
    v-else
    trigger="click"
    :options="themeOptions"
    @select="handleThemeChange"
  >
    <div class="theme-toggle-btn">
      <n-icon size="18" class="theme-icon">
        <component :is="themeIconComponent" />
      </n-icon>
    <span class="theme-label">{{ currentThemeLabel }}</span>
    </div>
  </n-dropdown>
</template>

<script setup lang="ts">
import { computed, h, markRaw } from "vue";
import { useTheme } from "@/composables/useTheme";
import { NTooltip, NDropdown, NIcon } from "naive-ui";
import { Sun, Moon, Monitor } from "lucide-vue-next";
import { $t } from "@/utils/i18n";
import { ThemeMode } from "@/types";

defineProps<{
  simple?: boolean;
}>();

const { themeMode, setTheme } = useTheme();

const themeIconComponent = computed(() => {
  switch (themeMode.value) {
    case ThemeMode.Light: return markRaw(Sun);
    case ThemeMode.Dark: return markRaw(Moon);
    case ThemeMode.System: return markRaw(Monitor);
    default: return markRaw(Monitor);
  }
});

const currentThemeLabel = computed(() => {
  switch (themeMode.value) {
    case ThemeMode.Light: return $t('settings.themeLight');
    case ThemeMode.Dark: return $t('settings.themeDark');
    case ThemeMode.System: return $t('settings.themeSystem');
    default: return $t('settings.themeSystem');
  }
});

const themeOrder = [
  ThemeMode.Light,
  ThemeMode.Dark,
  ThemeMode.System,
];

const cycleTheme = () => {
  const currentIndex = themeOrder.indexOf(themeMode.value);
  const nextIndex = (currentIndex + 1) % themeOrder.length;
  setTheme(themeOrder[nextIndex]);
};

const handleThemeChange = (key: ThemeMode) => {
  setTheme(key);
};

const renderIcon = (icon: any) => {
  return () => h(NIcon, null, { default: () => h(icon) });
};

const themeOptions = computed(() => [
  {
    label: $t('settings.themeLight'),
    key: ThemeMode.Light,
    icon: renderIcon(Sun)
  },
  {
    label: $t('settings.themeDark'),
    key: ThemeMode.Dark,
    icon: renderIcon(Moon)
  },
  {
    label: $t('settings.themeSystem'),
    key: ThemeMode.System,
    icon: renderIcon(Monitor)
  }
]);
</script>

