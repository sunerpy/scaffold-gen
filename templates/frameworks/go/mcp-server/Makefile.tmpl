SHELL = /bin/bash
PROJECT_NAME = <<project_name>>
MODULE_NAME = <<module_name>>
DIST_DIR = dist

# buf resolves protoc-gen-jsonschema from PATH (buf.gen.yaml declares it as `local:`),
# so the BINARY on PATH decides the emitted JSON Schema - go.mod does not.
PGJS_MIN_VERSION = <<protoc_gen_jsonschema_min_version>>
PGJS_PKG = github.com/sunerpy/protoc-gen-jsonschema/cmd/protoc-gen-jsonschema

GO_FILES = $(shell find . -name "*.go" -not -path "./vendor/*")

.PHONY: all check-plugin generate build run test fmt lint check clean help

all: fmt lint build

## check-plugin: assert protoc-gen-jsonschema is installed and >= PGJS_MIN_VERSION
check-plugin:
	@if ! command -v protoc-gen-jsonschema > /dev/null 2>&1; then \
		echo "ERROR: protoc-gen-jsonschema not found on PATH."; \
		echo "  required: >= v$(PGJS_MIN_VERSION)"; \
		echo "  found:    (not installed)"; \
		echo "  install:  go install $(PGJS_PKG)@latest"; \
		echo "            (or pin the minimum: go install $(PGJS_PKG)@v$(PGJS_MIN_VERSION))"; \
		echo "  note:     buf resolves this plugin from PATH, so the binary on PATH - not"; \
		echo "            the go.mod pin - decides the generated JSON Schema."; \
		exit 1; \
	fi
	@have=$$(protoc-gen-jsonschema --version 2>/dev/null | awk 'NR==1{print $$2; exit}' | sed 's/^[vV]//'); \
	where=$$(command -v protoc-gen-jsonschema); \
	if [ -z "$$have" ]; then \
		echo "ERROR: protoc-gen-jsonschema --version did not report a version."; \
		echo "  required: >= v$(PGJS_MIN_VERSION)"; \
		echo "  found:    unreadable ($$where)"; \
		echo "  install:  go install $(PGJS_PKG)@latest"; \
		echo "            (or pin the minimum: go install $(PGJS_PKG)@v$(PGJS_MIN_VERSION))"; \
		exit 1; \
	fi; \
	if awk -v have="$$have" -v min="$(PGJS_MIN_VERSION)" 'BEGIN{nh=split(have,h,"."); nm=split(min,m,"."); for(i=1;i<=3;i++){hv=(i<=nh?h[i]+0:0); mv=(i<=nm?m[i]+0:0); if(hv>mv) exit 0; if(hv<mv) exit 1} exit 0}'; then \
		echo "protoc-gen-jsonschema v$$have OK (>= v$(PGJS_MIN_VERSION))"; \
	else \
		echo "ERROR: protoc-gen-jsonschema is too old - refusing to generate a wrong JSON Schema."; \
		echo "  required: >= v$(PGJS_MIN_VERSION)"; \
		echo "  found:    v$$have ($$where)"; \
		echo "  install:  go install $(PGJS_PKG)@latest"; \
		echo "            (or pin the minimum: go install $(PGJS_PKG)@v$(PGJS_MIN_VERSION))"; \
		echo "  why:      older plugins render a proto3 map<string,string> field as a JSON Schema"; \
		echo "            array of key/value objects instead of an object with additionalProperties."; \
		echo "            buf generate, go build and go vet all still succeed, so the broken"; \
		echo "            contract only surfaces when an MCP client validates tool arguments."; \
		exit 1; \
	fi

## generate: regenerate protobuf + JSON Schema from proto/ (buf generate)
generate: check-plugin
	@echo "Running buf generate (proto + JSON Schema)..."
	@if command -v buf > /dev/null 2>&1; then \
		buf dep update && buf generate; \
	else \
		echo "buf not found. Install: https://buf.build/docs/installation"; \
		echo "The JSON Schema plugin (>= v$(PGJS_MIN_VERSION)) is also required:"; \
		echo "  go install $(PGJS_PKG)@latest"; \
		exit 1; \
	fi

## build: compile the server binary (run `make generate` first on a fresh clone)
build:
	@echo "Building $(PROJECT_NAME)..."
	@mkdir -p $(DIST_DIR)
	CGO_ENABLED=0 go build -ldflags="-s -w" -o $(DIST_DIR)/$(PROJECT_NAME) ./cmd/server

## run: build and run the server (reads config.toml)
run: build
	@echo "Starting $(PROJECT_NAME) (config.toml)..."
	./$(DIST_DIR)/$(PROJECT_NAME) -config config.toml

## test: run tests with the race detector
test:
	CGO_ENABLED=1 go test ./... -count=1 -race

## fmt: format Go code (gofumpt + goimports if available, else gofmt)
fmt:
	@echo "Formatting Go code..."
	@if command -v goimports > /dev/null 2>&1; then \
		echo "$(GO_FILES)" | tr ' ' '\n' | xargs -P 4 goimports -w -local $(MODULE_NAME); \
	fi
	@if command -v gofumpt > /dev/null 2>&1; then \
		echo "$(GO_FILES)" | tr ' ' '\n' | xargs -P 4 gofumpt -extra -w; \
	else \
		gofmt -w $(GO_FILES); \
	fi

## lint: run golangci-lint (falls back to go vet)
lint:
	@echo "Running linters..."
	@if command -v golangci-lint > /dev/null 2>&1; then \
		golangci-lint run ./...; \
	else \
		echo "golangci-lint not found. Running go vet..."; \
		go vet ./...; \
	fi

## check: format, lint, test, and verify the protoc-gen-jsonschema version
check: fmt lint test check-plugin

## clean: remove build artifacts
clean:
	@rm -rf $(DIST_DIR)
	@go clean -cache -testcache

## help: list targets
help:
	@grep -E '^##' $(MAKEFILE_LIST) | sed -e 's/## //'
