def _identity_claims_well_formed(claims: dict) -> bool:
    """回退链中每个身份 claim 若存在必须是非空字符串，否则认证失败.

    Each identity claim in the fallback chain, IF present, must be a non-empty string.
    """
    for name in ("client_id", "azp", "sub"):
        if name in claims:
            value = claims.get(name)
            if not isinstance(value, str) or not value:
                return False
    return True


class StrictAudienceJWTVerifier(JWTVerifier):
    """在 fastmcp 内置 JWTVerifier 之上加固 audience / NumericDate / 身份 claim 校验。

    verify_token 在任何校验失败时返回 None（不抛异常逃逸）→ 框架据此回 401。
    Returns None on any verification failure so the framework responds 401 (never a 500).
    """

    async def verify_token(self, token: str) -> AccessToken | None:
        # 单一最外层 except：只记录异常类型、绝不记录 token/claim 值。
        # 先由父类完成密码学验签(不复制/不绕过/不 re-raise)，仅在其返回 AccessToken 后加固。
        # Single outermost except logs only the type; the parent does the crypto verify.
        try:
            access = await super().verify_token(token)
            if access is None:
                return None

            claims = access.claims or {}

            # 与 official 后端字节一致的 exp/iat/nbf 校验（父类从不校验 iat/nbf）。
            # Same exp/iat/nbf validation as the official backend (parent never checks iat/nbf).
            if not _numeric_dates_valid(claims):
                return None

            # aud 必须是与配置精确相等的字符串（父类对数组 aud 命中任一元素即放过）。
            # aud must be a string exactly equal to the configured audience.
            aud = claims.get("aud")
            if not isinstance(aud, str) or aud != self.audience:
                return None

            if not _identity_claims_well_formed(claims):
                return None

            return access
        except Exception as exc:
            logger.debug("token_verify_failed", error_type=type(exc).__name__)
            return None
