"""MCP 工具注册中心 (tool registry).

═══════════════════════════════════════════════════════════════════════════
  这里是"MCP 工具"的总装配点。app/tools/ 目录下每个 *.py 文件只要定义了一个
  名为 `register(mcp)` 的函数，就会被自动发现并调用 —— 你不用改这个文件。
  Every *.py file in app/tools/ that defines a top-level `register(mcp)`
  function is auto-discovered and invoked. You do NOT edit this file to add
  a tool — just drop a new .py file next to echo.py.
═══════════════════════════════════════════════════════════════════════════
"""

import importlib
import pkgutil
from pathlib import Path

_TOOLS_DIR = Path(__file__).resolve().parent


def register_tools(mcp) -> None:
    """扫描本包下所有模块，调用其顶层 `register(mcp)` 函数."""
    for module_info in pkgutil.iter_modules([str(_TOOLS_DIR)]):
        module = importlib.import_module(f"{__name__}.{module_info.name}")
        register = getattr(module, "register", None)
        if callable(register):
            register(mcp)
