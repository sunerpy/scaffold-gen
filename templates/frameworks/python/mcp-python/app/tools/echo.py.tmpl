from typing import Annotated

from pydantic import Field

from app.logging import get_logger


# ── 1. 写你的工具函数 (write your tool function) ─────────────────────────────
#    用"扁平参数 + Annotated/Field"描述入参（不要包成一个 Pydantic 模型），
#    这样调用方式就是 call_tool("echo", {"text": "hi", "repeat": 2})。
#    Use FLAT params with Annotated/Field (not a single Pydantic model arg),
#    so the call is call_tool("echo", {"text": "hi", "repeat": 2}).
def echo(
    text: Annotated[str, Field(min_length=1, description="Text to echo back")],
    repeat: Annotated[int, Field(ge=1, le=10)] = 1,
) -> dict:
    """Echo text back, optionally repeated 1-10 times."""
    logger = get_logger(__name__)
    echoed = " ".join([text] * repeat)
    logger.info("echo_called", repeat=repeat)
    return {"echoed": echoed, "repeat": repeat}


# ── 2. 注册工具 (register the tool) —— 显式调用形式，两种后端通用 ──────────────
def register(mcp) -> None:
    """把本模块的工具注册到 MCP 实例上 (由 app/tools/__init__.py 自动调用)."""
    mcp.tool(name="echo", description="Echo text back, optionally repeated.")(echo)


# ── 装饰器替代写法 (decorator alternative) —— 仅当你锁定单一后端时 ─────────────
#  如果你确定只用一种后端，也可以用装饰器快速注册（更简洁）。但装饰器需要在模块里
#  拿到 `mcp` 实例，且两种后端的括号写法不同；本脚手架的工具文件不 import 后端、
#  由上面的 `register(mcp)` 接收实例，所以这里默认用通用的显式调用形式。
#  If you commit to ONE backend you can use the decorator for brevity. The explicit
#  `mcp.tool(...)(fn)` form used above is portable across both backends and keeps this
#  file backend-agnostic (no backend import, no module-level `mcp`). The decorator's
#  exact shape differs per backend:
#
#    # fastmcp（无括号即可 / parenless OK）：
