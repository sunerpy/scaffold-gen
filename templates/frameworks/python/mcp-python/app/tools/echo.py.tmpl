from typing import Annotated

from pydantic import Field

from app.logging import get_logger
from app.mcp_instance import mcp


# ── 写你的工具函数并用装饰器注册 (write + register via decorator) ──────────────
#    用"扁平参数 + Annotated/Field"描述入参（不要包成一个 Pydantic 模型），
#    这样调用方式就是 call_tool("echo", {"text": "hi", "repeat": 2})。
#    Use FLAT params with Annotated/Field (not a single Pydantic model arg),
#    so the call is call_tool("echo", {"text": "hi", "repeat": 2}).
<%if mcp_backend_is_official%>
# official SDK：装饰器必须带括号 / parentheses required.
@mcp.tool()
<%-else%>
# fastmcp（默认）：装饰器可省括号 / parenless OK.
@mcp.tool
<%-endif%>
def echo(
    text: Annotated[str, Field(min_length=1, description="Text to echo back")],
    repeat: Annotated[int, Field(ge=1, le=10)] = 1,
) -> dict:
    """Echo text back, optionally repeated 1-10 times."""
    logger = get_logger(__name__)
    echoed = " ".join([text] * repeat)
    logger.info("echo_called", repeat=repeat)
    return {"echoed": echoed, "repeat": repeat}


