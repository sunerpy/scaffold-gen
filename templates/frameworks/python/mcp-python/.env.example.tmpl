# ============================================================================
#  <<project_name>> — 环境变量 (Environment Variables)
# ----------------------------------------------------------------------------
#  复制本文件为 .env 后修改；.env 中的值会覆盖 config.toml 中的同名配置。
#  Copy this file to .env and edit. Values here OVERRIDE config.toml.
#  变量名格式：SERVER__HOST / SERVER__PORT / MCP__BACKEND （双下划线分层）。
# ============================================================================

# 监听地址 / Listen address
# SERVER__HOST=0.0.0.0

# 监听端口 / Listen port
# SERVER__PORT=8000

# MCP 后端 / MCP backend (fastmcp | official)
# MCP__BACKEND=official

# 是否启用 SSE 传输 / enable the SSE transport
# MCP__SSE_ENABLED=false
