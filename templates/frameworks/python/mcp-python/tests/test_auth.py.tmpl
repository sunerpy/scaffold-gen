from app.auth import JwksTokenVerifier


class _StubSigningKey:
    """模拟 PyJWKClient.get_signing_key_from_jwt 的返回：暴露 `.key`."""

    def __init__(self, key: str) -> None:
        self.key = key


@pytest.fixture
def verifier(keypair, monkeypatch) -> JwksTokenVerifier:
    """构造真实 JwksTokenVerifier，但把 JWKS 取键环节打桩成本地公钥（不走网络）.

    打桩的是最窄的接缝 `self._jwks.get_signing_key_from_jwt`，verify_token 里的
    jwt.decode（验签 + iss/aud/exp + scope）全部是真实执行。
    """
    _private_key, public_pem = keypair
    v = JwksTokenVerifier(
        jwks_uri="https://issuer.example/jwks",
        issuer=ISSUER,
        audience=AUDIENCE,
        algorithm=ALGORITHM,
        required_scopes=["mcp.read"],
    )
    monkeypatch.setattr(
        v._jwks,
        "get_signing_key_from_jwt",
        lambda _token: _StubSigningKey(public_pem),
    )
    return v


async def test_valid_token_accepted(verifier, keypair) -> None:
    """Given a correctly signed token / When verified / Then an AccessToken is returned."""
    private_key, _ = keypair
    token = _sign(private_key)
    access = await verifier.verify_token(token)
    assert access is not None
    assert access.subject == "user-123"
    assert "mcp.read" in access.scopes
    assert "mcp.call" in access.scopes


