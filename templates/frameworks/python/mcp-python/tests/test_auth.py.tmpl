# ── 传输层：test-local 带鉴权的 app（fastmcp）—— 证明恶意 claim 回 401、不 500、后续不损坏 ──
#    共享 conftest 的 client 在 import 前禁用了鉴权，无法证明 /mcp、/sse 的鉴权语义，故在此
#    本地新建一个鉴权已启用的 app：真实 StrictAudienceJWTVerifier（JWKS 取键打桩成本地公钥）+
#    fastmcp http_app 工厂拼装 /mcp、/sse，再把子应用的鉴权中间件复制到父应用。
import contextlib

from starlette.applications import Starlette
from starlette.routing import Route
from starlette.testclient import TestClient


@pytest.fixture
def auth_app(keypair):
    """本地构建鉴权已启用的 fastmcp app（stateless streamable + sse），JWKS 打桩成本地公钥."""
    _private_key, public_pem = keypair
    verifier = StrictAudienceJWTVerifier(
        jwks_uri="https://issuer.example/jwks",
        issuer=ISSUER,
        audience=AUDIENCE,
        algorithm=ALGORITHM,
        required_scopes=["mcp.read"],
    )

    async def _fake_get_jwks_key(_kid: str | None) -> str:
        return public_pem

    verifier._get_jwks_key = _fake_get_jwks_key  # noqa: SLF001

    from fastmcp import FastMCP

    mcp = FastMCP("auth-transport-test", auth=verifier)

    @mcp.tool
    def echo(msg: str) -> dict:
        return {"echo": msg}

    streamable_app = mcp.http_app(path="/mcp", stateless_http=True)
    sse_app = mcp.http_app(path="/sse", transport="sse")

    @contextlib.asynccontextmanager
    async def lifespan(app: Starlette):
        async with contextlib.AsyncExitStack() as stack:
            await stack.enter_async_context(streamable_app.lifespan(app))
            await stack.enter_async_context(sse_app.lifespan(app))
            yield

    routes: list = [Route("/healthz", lambda r: None)]
    routes.extend(streamable_app.routes)
    routes.extend(sse_app.routes)
    seen = set()
    middleware: list = []
    for sub in (streamable_app, sse_app):
        for m in getattr(sub, "user_middleware", []):
            key = getattr(m, "cls", m)
            if key not in seen:
                seen.add(key)
                middleware.append(m)
    return Starlette(routes=routes, middleware=middleware or None, lifespan=lifespan)


def _initialize(client: TestClient, private_key: rsa.RSAPrivateKey) -> int:
    """用合法 token 发一次 initialize，返回状态码（证明后续请求不因前一恶意请求而 500/损坏）."""
    resp = client.post(
        "/mcp",
        headers={
            "Authorization": f"Bearer {_sign(private_key)}",
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
        },
        json={
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "t", "version": "1"},
            },
        },
    )
    return resp.status_code


async def test_streamable_malicious_then_legit(auth_app, keypair) -> None:
    """Malicious array-aud token to /mcp / Then 401 (not 500); a legit request still 200."""
    private_key, _ = keypair
    with TestClient(auth_app) as client:
        bad_token = _sign_claims(private_key, aud=[AUDIENCE, "other"])
        bad = client.post(
            "/mcp",
            headers={
                "Authorization": f"Bearer {bad_token}",
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
            },
            json={"jsonrpc": "2.0", "id": 1, "method": "tools/list"},
        )
        assert bad.status_code == 401
        assert _initialize(client, private_key) == 200


async def test_sse_malicious_then_legit(auth_app, keypair) -> None:
    """Malicious future-iat token to /sse / Then 401 (not 500); /mcp still serves legit."""
    private_key, _ = keypair
    with TestClient(auth_app) as client:
        future_token = _sign_claims(private_key, iat=int(time.time()) + 10_000)
        bad = client.get(
            "/sse",
            headers={
                "Authorization": f"Bearer {future_token}",
            },
        )
        assert bad.status_code == 401
        assert _initialize(client, private_key) == 200
