"""鉴权校验器的离线单元测试 (offline auth-verifier tests).

本文件仅在 `--auth jwt` 生成的项目里出现。全程无网络：用本地 RSA 私钥签 JWT，
把校验器拉取公钥的环节打桩成本地公钥，从而走真实的 verify_token 代码路径。
This file ships only in `--auth jwt` projects. Fully network-free: we sign JWTs
with a local RSA private key and stub the verifier's key-fetch step so the REAL
verify_token code path runs against the locally generated public key.

pytest-asyncio auto 模式：直接写 `async def test_*`（见 pyproject asyncio_mode="auto"）。
"""

import os
import time

import jwt
import pytest
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa
from pydantic import ValidationError

from app.settings import load_settings

ISSUER = "https://issuer.example/realms/test"
AUDIENCE = "mcp-test-api"
KID = "test"
ALGORITHM = "RS256"


@pytest.fixture(scope="module")
def keypair() -> tuple[rsa.RSAPrivateKey, str]:
    """本地 RSA 私钥 + PEM 公钥 (a local RSA private key + its public-key PEM)."""
    private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    public_pem = (
        private_key.public_key()
        .public_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PublicFormat.SubjectPublicKeyInfo,
        )
        .decode()
    )
    return private_key, public_pem


def _sign(
    private_key: rsa.RSAPrivateKey,
    *,
    audience: str = AUDIENCE,
    issuer: str = ISSUER,
    scope: str = "mcp.read mcp.call",
    exp_delta: int = 3600,
    subject: str = "user-123",
) -> str:
    """用本地私钥签一个 RS256 JWT（默认所有声明都合法）。"""
    now = int(time.time())
    claims = {
        "iss": issuer,
        "aud": audience,
        "sub": subject,
        "iat": now,
        "exp": now + exp_delta,
        "scope": scope,
        "client_id": "client-abc",
    }
    private_pem = private_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption(),
    )
    return jwt.encode(claims, private_pem, algorithm=ALGORITHM, headers={"kid": KID})


def _sign_claims(private_key: rsa.RSAPrivateKey, **overrides: object) -> str:
    """签一个以默认合法 claims 为基础、按 overrides 逐键覆盖的 JWT；overrides 值为 None 则删除该键.

    Sign a JWT from valid defaults, applying per-key overrides (a None value deletes the key) so
    malformed-claim cases (bool/fraction/object/future/huge/non-finite exp/iat/nbf) can be built.
    """
    now = int(time.time())
    claims: dict = {
        "iss": ISSUER,
        "aud": AUDIENCE,
        "sub": "user-123",
        "iat": now,
        "exp": now + 3600,
        "scope": "mcp.read mcp.call",
        "client_id": "client-abc",
    }
    for key, value in overrides.items():
        if value is None:
            claims.pop(key, None)
        else:
            claims[key] = value
    private_pem = private_key.private_bytes(
        encoding=serialization.Encoding.PEM,
        format=serialization.PrivateFormat.PKCS8,
        encryption_algorithm=serialization.NoEncryption(),
    )
    return jwt.encode(claims, private_pem, algorithm=ALGORITHM, headers={"kid": KID})


# 恶意 / 畸形 exp / iat / nbf 输入的共享矩阵（两后端逐输入必须一致返回 None）。
MALFORMED_TIME_CLAIMS = [
    ("iat", True),
    ("iat", "123"),
    ("iat", 1.5),
    ("iat", {"x": 1}),
    ("iat", float("inf")),
    ("iat", float("nan")),
    ("iat", 10**1000),
    ("iat", int(time.time()) + 10_000),
    ("nbf", True),
    ("nbf", "123"),
    ("nbf", 1.5),
    ("nbf", {"x": 1}),
    ("nbf", float("inf")),
    ("nbf", 10**1000),
    ("nbf", int(time.time()) + 10_000),
]

# 恶意 / 畸形 identity claim 输入（若存在必须是非空字符串，否则返回 None）。
MALFORMED_IDENTITY_CLAIMS = [
    ("client_id", 123),
    ("client_id", True),
    ("client_id", ["a"]),
    ("client_id", {"x": 1}),
    ("azp", 123),
    ("azp", ["a"]),
    ("sub", 123),
    ("sub", True),
]


# ── fail-closed 启动边界（后端无关，只测 app.settings 加载与校验）─────────────────
def _scrub_auth_env(monkeypatch) -> None:
    for _key in list(os.environ):
        if _key.upper() == "AUTH" or _key.upper().startswith("AUTH__"):
            monkeypatch.delenv(_key, raising=False)


def test_enabled_without_config_fails_closed(monkeypatch) -> None:
    """Given auth enabled but no config / When settings load / Then it lists all missing fields."""
    _scrub_auth_env(monkeypatch)
    monkeypatch.setenv("AUTH__ENABLED", "true")
    with pytest.raises(ValidationError) as excinfo:
        load_settings()
    message = str(excinfo.value)
    for field in ("jwks_uri", "issuer", "audience", "resource_server_url"):
        assert field in message


def test_complete_auth_config_via_env_succeeds(monkeypatch) -> None:
    """Given a complete auth config via env / When settings load / Then auth is enabled."""
    _scrub_auth_env(monkeypatch)
    monkeypatch.setenv("AUTH__ENABLED", "true")
    monkeypatch.setenv("AUTH__JWKS_URI", "https://issuer.example/jwks")
    monkeypatch.setenv("AUTH__ISSUER", ISSUER)
    monkeypatch.setenv("AUTH__AUDIENCE", AUDIENCE)
    monkeypatch.setenv("AUTH__RESOURCE_SERVER_URL", "http://127.0.0.1:8000")
    loaded = load_settings()
    assert loaded.auth.enabled is True
    assert loaded.auth.audience == AUDIENCE


def test_auth_mode_cannot_be_tampered(monkeypatch) -> None:
    """Given AUTH__MODE set to a foreign value / When settings load / Then literal_error raised."""
    _scrub_auth_env(monkeypatch)
    monkeypatch.setenv("AUTH__ENABLED", "false")
    monkeypatch.setenv("AUTH__MODE", "tampered-mode")
    with pytest.raises(ValidationError):
        load_settings()

