# ============================================================================
#  <<project_name>> — 本地开发配置 (Local Dev Configuration)
# ----------------------------------------------------------------------------
#  ★ 改开发服务器地址 / 端口 / 允许的 Host / API 地址，只改这里，不要改代码 ★
#  vite.config.ts 在启动时通过 Vite 的 loadEnv 读取这些值。
#  Change dev-server host/port/allowed-hosts and the API base URL HERE.
#  vite.config.ts reads these via Vite's loadEnv at startup.
#  以 VITE_ 开头的变量会被注入到客户端 (import.meta.env.*)。
#  Variables prefixed with VITE_ are exposed to the client (import.meta.env.*).
# ============================================================================

# 开发服务器监听地址：本机用 127.0.0.1；容器/局域网访问用 0.0.0.0
# Dev server host. Use 127.0.0.1 for local only, 0.0.0.0 to expose on the LAN.
VITE_DEV_HOST=0.0.0.0

# 开发服务器端口 / Dev server port
VITE_DEV_PORT=5173

# 允许访问开发服务器的 Host 列表（逗号分隔）；填 "all" 放行任意 Host。
# Comma-separated allowed hosts for the dev server. Use "all" to allow any host.
VITE_DEV_ALLOWED_HOSTS=localhost,127.0.0.1

# 应用调用的后端 API 地址，注入到客户端 import.meta.env.VITE_API_BASE_URL。
# API base URL the app calls; exposed to the client as import.meta.env.VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8000

# 可选：开发代理目标。非空时把 /api 反向代理到该地址（绕过 CORS）；留空则禁用。
# Optional dev proxy target. When set, /api is proxied here (avoids CORS); empty disables it.
VITE_DEV_PROXY_TARGET=
